# ---------------------------------------------------------------------------
# Vanguard Trading — Backend Environment Configuration (example)
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# App
APP_NAME="Vanguard Trading API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://vanguard:vanguard@localhost:5432/vanguard_trading
DATABASE_URL_SYNC=postgresql+psycopg2://vanguard:vanguard@localhost:5432/vanguard_trading

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Market data: "live" pulls real prices from CoinGecko (no API key needed for
# this call volume); "simulated" uses the controlled random-walk engine for
# offline dev. Order execution is always simulated paper trading either way.
MARKET_DATA_SOURCE=live
MARKET_UPDATE_INTERVAL_SECONDS=30
MARKET_MIN_MOVEMENT_PCT=-0.6
MARKET_MAX_MOVEMENT_PCT=0.6
MARKET_VOLATILITY_LEVEL=medium

# Paper trading
STARTING_PAPER_BALANCE=100000
DEFAULT_ACCOUNT_CURRENCY=USD

# Email (architecture only for MVP — no real provider wired up)
EMAIL_FROM=no-reply@vanguardtrading.dev
EMAIL_PROVIDER=console

# --- Market data providers ---------------------------------------------------
# CoinGecko prices crypto and needs no key. Twelve Data prices equities, FX and
# spot metals; leave the key blank and those assets stay on the simulated
# engine. Exchange-traded futures (WTI, Brent, grains, LME metals) are not
# covered by either and remain simulated regardless.
TWELVEDATA_API_KEY=
# Symbols per /quote call, and the pause between chunks. Lower both if your
# plan's per-minute limit is tight.
TWELVEDATA_BATCH_SIZE=8
TWELVEDATA_BATCH_DELAY_SECONDS=1.0
# Equities/FX/metals poll on this slower cadence; crypto keeps the fast tick.
NON_CRYPTO_UPDATE_INTERVAL_SECONDS=300
